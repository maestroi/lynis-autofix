# Copy to scripts/prod-remote.env.local and adjust for your environment.
HARDENER_PROD_HOST=x@xxx
HARDENER_PROD_SSH_OPTS='-o StrictHostKeyChecking=accept-new'
HARDENER_PROD_REMOTE_WORKDIR=/opt/hardener
HARDENER_PROD_STATE_DIR=/var/lib/hardener
HARDENER_PROD_PROFILE=server
HARDENER_PROD_OUTPUT=table
HARDENER_PROD_REPORT_PATH=/var/log/lynis-report.dat
HARDENER_PROD_LYNIS_CMD='lynis audit system --quick'
# Lynis install policy:
# - package: ensure package-manager Lynis is installed
# - latest: ensure exact upstream version from downloads.cisofy.com
# - skip: do not install/upgrade Lynis
HARDENER_PROD_LYNIS_ENSURE=package
# Used only when HARDENER_PROD_LYNIS_ENSURE=latest
HARDENER_PROD_LYNIS_VERSION=3.1.6
HARDENER_PROD_APPLY=0
HARDENER_PROD_CONFIRM_DANGEROUS=0
# Leave empty to skip rollback. Set to a run ID or "latest" to rollback latest run.
HARDENER_PROD_ROLLBACK_RUN_ID=
# Optional override; defaults to "sudo"
HARDENER_PROD_SUDO=sudo
